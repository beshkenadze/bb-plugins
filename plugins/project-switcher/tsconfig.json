{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "server.ts",
    "app.tsx",
    "model.ts",
    "project-switcher.tsx",
    "sidebar.ts",
    "*.test.ts",
    "*.test.tsx",
    "vitest.config.ts",
    "components",
    "lib",
    "hooks",
    "test"
  ]
}
