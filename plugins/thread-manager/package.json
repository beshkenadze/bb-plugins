{
  "name": "bb-plugin-thread-manager",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Restart agents from thread headers and manage BB threads in a dedicated UI.",
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Thread Manager",
    "description": "Restart the agent from its thread header. Search and filter threads across projects, manage archived work, and organize threads with individual and bulk actions.",
    "branding": {
      "icon": "ListFilter"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": ["skills"]
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.2",
    "jsdom": "^30.1.2",
    "vitest": "^4.1.11",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
